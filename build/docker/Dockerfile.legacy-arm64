FROM ubuntu:20.04

# Install build prerequisites (Ubuntu 20.04 / glibc 2.31+)
# clang-12 and lld-12 are available in the standard focal repos — no PPA needed.
RUN apt-get update -qq && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      curl ca-certificates gnupg2 apt-transport-https \
      build-essential clang-12 lld-12 pkg-config zlib1g-dev libssl-dev libicu-dev file zip \
      libunwind-dev gettext libatomic1 && \
    rm -rf /var/lib/apt/lists/*

# Install .NET SDK via dotnet-install script
ENV DOTNET_INSTALL_DIR=/usr/share/dotnet
RUN curl -sSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh && \
    bash /tmp/dotnet-install.sh --channel 10.0 --install-dir "$DOTNET_INSTALL_DIR" --architecture arm64 && \
    rm -f /tmp/dotnet-install.sh

ENV PATH="$DOTNET_INSTALL_DIR:$PATH"
WORKDIR /workspace
