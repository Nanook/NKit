<Project>

  <!-- ═══════════════════════════════════════════════════════════════════════
       Centralized Version Management
       ═══════════════════════════════════════════════════════════════════════
       Version is derived from git tags at CI time via -p:Version=X.Y.Z
       Local builds without -p:Version will default to 0.0.0-local.
       
       Tag format: v2.0.0, v2.1.0-alpha, v2.1.0-rc.1, etc.
       The leading 'v' is stripped by CI before passing to MSBuild.
       ═══════════════════════════════════════════════════════════════════════ -->

  <PropertyGroup>
    <!-- Default version for local development builds (overridden by CI via -p:Version=) -->
    <Version Condition="'$(Version)' == ''">0.0.0</Version>
    <AssemblyVersion>$(Version.Split('-')[0])</AssemblyVersion>
    <FileVersion>$(Version.Split('-')[0])</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <!-- Do not let the SDK append '+<commitHash>' to InformationalVersion (the 4th/metadata
         element). GetVersion() also strips it defensively, but keep the assembly attribute clean. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Suppress NU1903: Microsoft.DotNet.ILCompiler 10.0.11 (Brotli decoder OOB write,
         GHSA-p3jp-9v83-76w9). The patched version is 10.0.14, shipped with SDK 10.0.114 /
         10.0.403. The installed SDK (10.0.3xx feature band) does not have a patched release
         yet. NKit processes local files, not untrusted Brotli network streams, so the
         practical risk is negligible. Remove this suppression when the SDK is updated. -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

</Project>
