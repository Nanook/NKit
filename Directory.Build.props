<Project>

  <!-- ═══════════════════════════════════════════════════════════════════════
       Centralized Version Management
       ═══════════════════════════════════════════════════════════════════════
       Version is derived from git tags at CI time via -p:Version=X.Y.Z
       Local builds without -p:Version will default to 0.0.0-local.
       
       Tag format: v2.0.0, v2.1.0-alpha, v2.1.0-rc.1, etc.
       The leading 'v' is stripped by CI before passing to MSBuild.
       ═══════════════════════════════════════════════════════════════════════ -->

  <PropertyGroup>
    <!-- Default version for local development builds (overridden by CI via -p:Version=) -->
    <Version Condition="'$(Version)' == ''">0.0.0</Version>
    <AssemblyVersion>$(Version.Split('-')[0])</AssemblyVersion>
    <FileVersion>$(Version.Split('-')[0])</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <!-- Do not let the SDK append '+<commitHash>' to InformationalVersion (the 4th/metadata
         element). GetVersion() also strips it defensively, but keep the assembly attribute clean. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

</Project>
