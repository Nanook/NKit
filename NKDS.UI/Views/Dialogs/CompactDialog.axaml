<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NkdsUi.ViewModels"
        x:Class="NkdsUi.Views.Dialogs.CompactDialog"
        x:DataType="vm:CompactDialogViewModel"
        Title="Compact Sets"
        Icon="/Assets/NkdsIcon.ico"
        Width="440" Height="400"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="20">
        <!-- Footer: Buttons -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="12"
                    Margin="0,16,0,0">
            <Button Content="Fast Compact"
                    Command="{Binding ConfirmFastCommand}"
                    Classes="dialogConfirm"
                    ToolTip.Tip="Rebuild index only — merge deltas, remove dead sections. Shard files are never touched."/>
            <Button Content="Compact"
                    Command="{Binding ConfirmCommand}"
                    Classes="dialogConfirm"
                    ToolTip.Tip="Full compact — permanently reclaims shard space. Irreversible."/>
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Classes="dialogCancel"/>
        </StackPanel>

        <!-- Content -->
        <StackPanel Spacing="12">
            <!-- Description -->
            <TextBlock TextWrapping="Wrap" Opacity="0.85">
                <Run Text="Compact" FontWeight="SemiBold"/> — reclaims disk space by permanently purging removed images and their blocks.
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Opacity="0.85">
                <Run Text="Fast Compact" FontWeight="SemiBold"/> — rebuilds the index only: merges deltas, removes dead sections. Shard files are never touched. Safe to run anytime.
            </TextBlock>

            <!-- Set Checklist -->
            <StackPanel Spacing="4">
                <DockPanel>
                    <TextBlock Text="Select sets to compact:"
                               FontWeight="SemiBold"
                               DockPanel.Dock="Left"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8">
                        <Button Content="All"
                                Command="{Binding SelectAllCommand}"
                                Padding="8,2"
                                FontSize="11"/>
                        <Button Content="None"
                                Command="{Binding SelectNoneCommand}"
                                Padding="8,2"
                                FontSize="11"/>
                    </StackPanel>
                </DockPanel>
                <Border BorderBrush="{DynamicResource MaterialDividerBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="4"
                        MaxHeight="140">
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Sets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CompactSetItem">
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              Content="{Binding Name}"
                                              Margin="4,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <!-- Irreversibility warning (full compact only) -->
            <TextBlock Text="⚠ Compact is irreversible. Removed images will be permanently deleted."
                       TextWrapping="Wrap"
                       Foreground="#FF9800"
                       FontSize="12"
                       Margin="0,4,0,0"/>

            <!-- Dynamic warning message -->
            <TextBlock Text="{Binding WarningMessage}"
                       IsVisible="{Binding WarningMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       TextWrapping="Wrap"
                       FontStyle="Italic"
                       Foreground="{DynamicResource MaterialValidationErrorBrush}"/>
        </StackPanel>
    </DockPanel>
</Window>
