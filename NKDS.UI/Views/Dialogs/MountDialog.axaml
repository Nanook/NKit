<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NkdsUi.ViewModels"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="350"
        x:Class="NkdsUi.Views.Dialogs.MountDialog"
        x:DataType="vm:MountDialogViewModel"
        Width="500" Height="450"
        MinWidth="400" MinHeight="400"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/NkdsIcon.ico"
        Title="Mount Set">

    <Design.DataContext>
        <vm:MountDialogViewModel/>
    </Design.DataContext>

    <DockPanel Margin="16">
        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Padding="0,0,0,12"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource MaterialDividerBrush}">
            <TextBlock Text="{Binding SetName, StringFormat='Mount: {0}'}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryHueMidBrush}"/>
        </Border>

        <!-- Footer Buttons -->
        <Border DockPanel.Dock="Bottom"
                Padding="0,12,0,0"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource MaterialDividerBrush}">
            <StackPanel Spacing="8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                Spacing="8">
                        <Button Content="Mount"
                                Classes="dialogConfirm"
                                Command="{Binding ConfirmCommand}"/>
                        <Button Content="Cancel"
                                Classes="dialogCancel"
                                Command="{Binding CancelCommand}"/>
                    </StackPanel>
                    <Panel/>
                </DockPanel>

                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           FontStyle="Italic"
                           Opacity="0.85"
                           Foreground="{DynamicResource MaterialValidationErrorBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <StackPanel Margin="0,16,0,0" Spacing="16">
            <!-- Platform Unsupported Warning -->
            <Border IsVisible="{Binding !IsPlatformSupported}"
                    Padding="12"
                    CornerRadius="4"
                    Background="{DynamicResource MaterialValidationErrorBrush}"
                    Opacity="0.15">
                <TextBlock Text="{Binding PlatformUnsupportedReason}"
                           Foreground="{DynamicResource MaterialValidationErrorBrush}"
                           TextWrapping="Wrap"
                           FontWeight="Medium"/>
            </Border>

            <!-- Mount Point Path -->
            <StackPanel Spacing="4">
                <TextBlock Text="Mount Point:" Opacity="0.7"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Classes="Flat"
                            Command="{Binding BrowseCommand}"
                            Height="30" Width="30" Padding="0"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0"
                            ToolTip.Tip="Select mount point folder">
                        <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="18" Height="18"/>
                    </Button>
                    <Panel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Content="▾"
                                    Classes="Flat"
                                    Width="28"
                                    Padding="0"
                                    x:Name="MountHistoryButton"/>
                            <TextBox Text="{Binding MountPoint, Mode=TwoWay}"
                                     PlaceholderText="Select mount point directory..."
                                     x:Name="MountPointTextBox"/>
                        </DockPanel>
                        <Popup x:Name="MountHistoryPopup"
                               PlacementTarget="{Binding #MountPointTextBox}"
                               Placement="Bottom"
                               IsOpen="False"
                               MaxHeight="250"
                               Width="{Binding #MountPointTextBox.Bounds.Width}">
                            <Border Background="#2D2D2D"
                                    BorderBrush="{DynamicResource MaterialDividerBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <ListBox x:Name="MountHistoryList"
                                         ItemsSource="{Binding MountPathHistory}"
                                         SelectionMode="Single"/>
                            </Border>
                        </Popup>
                    </Panel>
                </DockPanel>
            </StackPanel>

            <!-- Mount Options -->
            <StackPanel Spacing="8">
                <TextBlock Text="Mount Options:" Opacity="0.7"/>
                <CheckBox Content="Show Image"
                          IsChecked="{Binding ShowImage}"
                          IsEnabled="{Binding ViewOptionsEnabled}"
                          ToolTip.Tip="Expose disc images as files in the mounted filesystem"/>
                <CheckBox Content="Show FileSystem"
                          IsChecked="{Binding ShowFileSystem}"
                          IsEnabled="{Binding ViewOptionsEnabled}"
                          ToolTip.Tip="Expose the filesystem contents of disc images"/>
                <CheckBox Content="Show System"
                          IsChecked="{Binding ShowSystem}"
                          IsEnabled="{Binding ViewOptionsEnabled}"
                          ToolTip.Tip="Expose system-level metadata in the mounted filesystem"/>

                <Border Height="1" Background="{DynamicResource MaterialDividerBrush}" Margin="0,4"/>

                <CheckBox Content="Update Mode"
                          IsChecked="{Binding UpdateMode}"
                          ToolTip.Tip="Mount in update mode for writing update partition data (mutually exclusive with view options)"/>
            </StackPanel>

            <!-- Linux FUSE Options -->
            <StackPanel Spacing="8" IsVisible="{Binding IsLinux}">
                <TextBlock Text="Linux Options:" Opacity="0.7"/>
                <CheckBox Content="Allow other users"
                          IsChecked="{Binding AllowOther}"
                          ToolTip.Tip="Allow other users to access the mount (requires user_allow_other in /etc/fuse.conf)"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Label Content="UID:" Width="40" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding UidText, Mode=TwoWay}"
                             PlaceholderText="e.g. 1000"
                             Width="120"
                             ToolTip.Tip="Override file owner UID (numeric ID). Auto-enables allow_other."/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Label Content="GID:" Width="40" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding GidText, Mode=TwoWay}"
                             PlaceholderText="e.g. 1000"
                             Width="120"
                             ToolTip.Tip="Override group owner GID (numeric ID). Auto-enables allow_other."/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
