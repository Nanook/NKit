<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NkdsUi.ViewModels"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="NkdsUi.Views.Dialogs.AddImagesDialog"
        x:DataType="vm:AddImagesDialogViewModel"
        Title="Add Images"
        Icon="/Assets/NkdsIcon.ico"
        Width="550" Height="420"
        MinWidth="400" MinHeight="300"
        CanResize="True"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="16">
        <!-- Header -->
        <TextBlock DockPanel.Dock="Top"
                   Text="Add Images to DataStore"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryHueMidBrush}"
                   Margin="0,0,0,12"/>

        <!-- Footer: Target Set + Buttons -->
        <StackPanel DockPanel.Dock="Bottom" Spacing="12" Margin="0,12,0,0">
            <!-- Target Set Selection -->
            <Border BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource MaterialDividerBrush}"
                    Padding="0,12,0,0">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
                    <TextBlock Text="Target Set:"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailableSetNames}"
                              SelectedItem="{Binding SelectedSetName, Mode=TwoWay}"
                              PlaceholderText="Select target set"
                              HorizontalAlignment="Stretch"/>
                </Grid>
            </Border>

            <!-- Buttons -->
            <DockPanel>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            Spacing="8">
                    <Button Content="OK"
                            Command="{Binding ConfirmCommand}"
                            Classes="dialogConfirm"/>
                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Classes="dialogCancel"/>
                </StackPanel>
                <Border/>
            </DockPanel>
        </StackPanel>

        <!-- File List Area -->
        <DockPanel Margin="0,0,0,0" DragDrop.AllowDrop="True">
            <!-- Browse Buttons -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                <Button Command="{Binding BrowseCommand}"
                        Classes="Flat"
                        Height="30" Padding="6,0"
                        ToolTip.Tip="Select image files">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="FileOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                        <TextBlock Text="Add Images" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding BrowseDirectoryCommand}"
                        Classes="Flat"
                        Height="30" Padding="6,0"
                        ToolTip.Tip="Select a folder to add all image files recursively">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                        <TextBlock Text="Add Directory" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Selected Files ListBox -->
            <Border BorderThickness="1"
                    BorderBrush="{DynamicResource MaterialDividerBrush}"
                    CornerRadius="4"
                    Padding="4">
                <Grid>
                    <ListBox ItemsSource="{Binding SelectedFiles}"
                             SelectionMode="Single"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="4,2"/>
                                <Setter Property="MinHeight" Value="26"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right"
                                            Content="✕"
                                            Command="{Binding $parent[Window].((vm:AddImagesDialogViewModel)DataContext).RemoveFileCommand}"
                                            CommandParameter="{Binding}"
                                            Classes="Flat"
                                            FontSize="10"
                                            Padding="4,2"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding}"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- Drop hint shown when list is empty -->
                    <TextBlock Text="Drop files here or click Add Images"
                               IsVisible="{Binding !SelectedFiles.Count}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Opacity="0.4"
                               FontSize="13"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>
        </DockPanel>
    </DockPanel>
</Window>
