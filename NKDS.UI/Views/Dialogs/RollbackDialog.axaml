<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NkdsUi.ViewModels"
        x:Class="NkdsUi.Views.Dialogs.RollbackDialog"
        x:DataType="vm:RollbackDialogViewModel"
        Title="Rollback"
        Icon="/Assets/NkdsIcon.ico"
        Width="520" Height="500"
        MinWidth="400" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <Window.Styles>
        <!-- DataGrid selection highlight -->
        <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="#AA7B1FA2"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="DataGridRow:selected DataGridCell">
            <Setter Property="Background" Value="#AA7B1FA2"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="DataGridRow:selected DataGridCell TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="#447B1FA2"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="24">
        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
            <TextBlock Text="Rollback to Image" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="Select the set and target image to rollback to. All images added after the selected image will be permanently and irreversibly deleted."
                       TextWrapping="Wrap"
                       Opacity="0.7"
                       FontSize="12"/>
        </StackPanel>

        <!-- Set Dropdown -->
        <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,12">
            <TextBlock Text="Set" FontWeight="SemiBold" FontSize="13"/>
            <ComboBox ItemsSource="{Binding AvailableSetNames}"
                      SelectedItem="{Binding SelectedSetName, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"/>
        </StackPanel>

        <!-- Image List -->
        <Border Grid.Row="2"
                BorderThickness="1"
                BorderBrush="{DynamicResource MaterialDividerBrush}"
                CornerRadius="4"
                Padding="0">
            <DataGrid ItemsSource="{Binding Images}"
                      SelectedItem="{Binding SelectedImage, Mode=TwoWay}"
                      SelectionMode="Single"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      LoadingRow="DataGrid_LoadingRow">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding Id}"
                                        Width="80"/>
                    <DataGridTextColumn Header="Name"
                                        Binding="{Binding Name}"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Warning -->
        <Border Grid.Row="3"
                IsVisible="{Binding HasWarning}"
                Background="#33FF9800"
                CornerRadius="4"
                Padding="12,8"
                Margin="0,12,0,0">
            <TextBlock Text="{Binding WarningText}"
                       Foreground="#FF9800"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,16,0,0">
            <Button Content="Rollback"
                    Command="{Binding ConfirmCommand}"
                    Width="90"
                    Classes="dialogConfirm"/>
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Width="90"
                    Classes="dialogCancel"/>
        </StackPanel>
    </Grid>
</Window>
