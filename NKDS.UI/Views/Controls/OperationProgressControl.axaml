<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NkdsUi.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="60"
             x:Class="NkdsUi.Views.Controls.OperationProgressControl"
             x:DataType="vm:OperationProgressViewModel">

    <UserControl.Styles>
        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="#CE93D8"/>
            <Setter Property="Background" Value="#447B1FA2"/>
        </Style>
    </UserControl.Styles>

    <Border Padding="8,6" Margin="0,2" CornerRadius="4"
            Background="#2A2A2A" BorderBrush="#444" BorderThickness="1">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
            <!-- Operation Name (bold) -->
            <TextBlock Grid.Column="0"
                       Text="{Binding OperationName}"
                       FontWeight="Bold"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"
                       MinWidth="80"/>

            <!-- Progress Bar + Current File Name -->
            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ProgressBar Grid.Row="0"
                             Minimum="0" Maximum="100"
                             Value="{Binding Percentage}"
                             Height="10"
                             Margin="0,0,0,2"/>

                <!-- Current file name below progress bar -->
                <TextBlock Grid.Row="1"
                           Text="{Binding CurrentFileName}"
                           FontSize="12"
                           Opacity="0.7"
                           TextTrimming="CharacterEllipsis"
                           TextAlignment="Center"
                           HorizontalAlignment="Stretch"/>
            </Grid>

            <!-- Percentage label -->
            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center"
                       FontSize="13"
                       Margin="0,0,12,0"
                       MinWidth="40"
                       TextAlignment="Right">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0}%">
                        <Binding Path="Percentage"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <!-- Items processed / total -->
            <TextBlock Grid.Column="3"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Margin="0,0,12,0"
                       Opacity="0.8"
                       Text="{Binding CounterDisplay}"/>

            <!-- Elapsed time -->
            <TextBlock Grid.Column="4"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Margin="0,0,12,0"
                       Opacity="0.8"
                       Text="{Binding ElapsedDisplay}"
                       MinWidth="60"/>

            <!-- Cancel button -->
            <Button Grid.Column="5"
                    Command="{Binding CancelCommand}"
                    VerticalAlignment="Center"
                    Classes="Flat"
                    Padding="8,4">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <materialIcons:MaterialIcon Kind="Cancel" Width="16" Height="16"/>
                    <TextBlock Text="Cancel"
                               VerticalAlignment="Center"
                               IsVisible="{Binding !IsCancelling}"/>
                    <TextBlock Text="Cancelling..."
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsCancelling}"/>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>
