<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Put packages under the workspace to avoid using machine-specific Windows paths -->
    <add key="globalPackagesFolder" value="./.nuget/packages" />
  </config>

  <packageSources>
    <!-- Ensure we use nuget.org only (or adjust as needed) -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- Clear fallback package folders so Windows paths in global config won't be used -->
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
