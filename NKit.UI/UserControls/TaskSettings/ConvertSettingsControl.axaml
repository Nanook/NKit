<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wpf="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
             xmlns:vm="clr-namespace:NKit.Ui.ViewModels.TaskSettings"
             xmlns:uc="clr-namespace:NKit.Ui.UserControls.TaskSettings"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:cnv="clr-namespace:NKit.Ui.Converters"
             xmlns:dt="clr-namespace:NKit.Ui.UserControls.Shared"
             xmlns:tips="clr-namespace:NKit.Ui.UserControls.Shared"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="NKit.Ui.UserControls.TaskSettings.ConvertSettingsControl"
             x:DataType="vm:ConvertSettingsViewModel">
    <UserControl.Resources>
        <cnv:ShowTooltipsToTipConverter x:Key="ShowTooltipsToTipConverter" />
    </UserControl.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Theme="{StaticResource MaterialModernScrollViewer}">
        <StackPanel Spacing="10" Margin="5">
            <!-- Format Section -->
            <StackPanel Spacing="20" Margin="0,10,0,10">
                <!-- Single Format Systems -->
                <StackPanel IsVisible="{Binding IsSingleFormatVisible}" Spacing="15">
                    <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsSingleFormatVisible}">
                        <Label Content="Format Single:" FontWeight="Bold" VerticalAlignment="Center" Width="120" dt:DelayedTooltip.Text="{x:Static tips:TooltipTexts.Convert_Label_FormatSingle}"/>
                        <ComboBox ItemsSource="{Binding AvailableFormats}" SelectedItem="{Binding SelectedSingleFormat}" Width="140" Height="30" Classes="Dense" dt:DelayedTooltip.Text="{x:Static tips:TooltipTexts.Convert_Combo_FormatSingle}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    
                    <!-- Single Format Options -->
                    <StackPanel Margin="20,0,0,0" Spacing="15">
                        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsEncodingVisible}">
                            <Label Content="Encoding:" Width="100" VerticalAlignment="Center" dt:DelayedTooltip.Text="{x:Static tips:TooltipTexts.Convert_Label_Encoding}"/>
                            <ComboBox ItemsSource="{Binding AvailableEncodings}" SelectedItem="{Binding SelectedEncoding}" Width="140" Height="30" Classes="Dense" dt:DelayedTooltip.Text="{x:Static tips:TooltipTexts.Convert_Combo_Encoding}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsLevelVisible}">
                            <Label Content="Level:" Width="100" VerticalAlignment="Center" dt:DelayedTooltip.Text="{x:Static tips:TooltipTexts.Convert_Label_Level}"/>
                            <ComboBox ItemsSource="{Binding AvailableLevels}" SelectedItem="{Binding SelectedLevel}" Width="140" Height="30" Classes="Dense" dt:DelayedTooltip.Text="{x:Static tips:TooltipTexts.Convert_Combo_Level}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsBlockSizeVisible}">
                            <Label Content="Block Size:" Width="100" VerticalAlignment="Center" dt:DelayedTooltip.Text="{x:Static tips:TooltipTexts.Convert_Label_BlockSize}"/>
                            <ComboBox ItemsSource="{Binding AvailableBlockSizes}" SelectedItem="{Binding SelectedBlockSize}" Width="140" Height="30" Classes="Dense" dt:DelayedTooltip.Text="{x:Static tips:TooltipTexts.Convert_Combo_BlockSize}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsParallelismVisible}">
                            <Label Content="Parallelism:" Width="100" VerticalAlignment="Center" dt:DelayedTooltip.Text="{x:Static tips:TooltipTexts.Convert_Label_Parallelism}"/>
                            <ComboBox ItemsSource="{Binding AvailableParallelisms}" SelectedItem="{Binding SelectedParallelism}" Width="140" Height="30" Classes="Dense" dt:DelayedTooltip.Text="{x:Static tips:TooltipTexts.Convert_Combo_Parallelism}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsLosslessVisible}">
                            <Label Content="Lossless:" Width="100" VerticalAlignment="Center" dt:DelayedTooltip.Text="{x:Static tips:TooltipTexts.Convert_Label_Lossless}"/>
                            <CheckBox IsChecked="{Binding IsLosslessSelected}" VerticalAlignment="Center" dt:DelayedTooltip.Text="{x:Static tips:TooltipTexts.Convert_Check_Lossless}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                
                <!-- Indexed Format Systems -->
                <StackPanel IsVisible="{Binding IsIndexedFormatVisible}" Spacing="15">

                    <!-- Indexed format selector for dual-format systems -->
                    <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsIndexedFormatVisible}">
                        <Label Content="Format Indexed:" FontWeight="Bold" VerticalAlignment="Center" Width="120" dt:DelayedTooltip.Text="{x:Static tips:TooltipTexts.Convert_Label_FormatIndexed}"/>
                        <ComboBox ItemsSource="{Binding AvailableIndexFormats}" SelectedItem="{Binding SelectedIndexFormat}" Width="140" Height="30" Classes="Dense" dt:DelayedTooltip.Text="{x:Static tips:TooltipTexts.Convert_Combo_FormatIndexed}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    
                    <!-- Index Options -->
                    <StackPanel Margin="20,0,0,0" Spacing="15">
                        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsCueTypeVisible}">
                            <Label Content="Type:" Width="100" VerticalAlignment="Center" dt:DelayedTooltip.Text="{x:Static tips:TooltipTexts.Convert_Label_CueType}"/>
                            <ComboBox ItemsSource="{Binding AvailableCueTypes}" SelectedItem="{Binding SelectedCueType}" Width="140" Height="30" Classes="Dense" dt:DelayedTooltip.Text="{x:Static tips:TooltipTexts.Convert_Combo_CueType}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsBinaryExtensionVisible}">
                            <Label Content="Binary:" Width="100" VerticalAlignment="Center" dt:DelayedTooltip.Text="{x:Static tips:TooltipTexts.Convert_Label_BinaryExtension}"/>
                            <ComboBox ItemsSource="{Binding AvailableBinaryExtensions}" SelectedItem="{Binding SelectedBinaryExtension}" Width="140" Height="30" Classes="Dense" dt:DelayedTooltip.Text="{x:Static tips:TooltipTexts.Convert_Combo_BinaryExtension}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsAudioExtensionVisible}">
                            <Label Content="Audio:" Width="100" VerticalAlignment="Center" dt:DelayedTooltip.Text="{x:Static tips:TooltipTexts.Convert_Label_AudioExtension}"/>
                            <ComboBox ItemsSource="{Binding AvailableAudioExtensions}" SelectedItem="{Binding SelectedAudioExtension}" Width="140" Height="30" Classes="Dense" dt:DelayedTooltip.Text="{x:Static tips:TooltipTexts.Convert_Combo_AudioExtension}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            
            <!-- Verification Method -->
            <StackPanel Orientation="Vertical" Spacing="7" Margin="0,10,0,20">
                <Label Content="Verification Method:" Margin="-5,5,0,0" FontWeight="Bold" />
				<RadioButton IsChecked="{Binding IsDynamicVerifySelected}" Content="Dynamic - Best method chosen based on conversion type" dt:DelayedTooltip.Text="{x:Static tips:TooltipTexts.Convert_Radio_DynamicVerify}"/>
                <RadioButton IsChecked="{Binding IsDatLookupVerifySelected}" Content="DAT Lookup - Expanded image must match DAT hashes"  dt:DelayedTooltip.Text="{x:Static tips:TooltipTexts.Convert_Radio_DatLookupVerify}"/>
                <RadioButton IsChecked="{Binding IsNoneVerifySelected}" Content="None"  dt:DelayedTooltip.Text="{x:Static tips:TooltipTexts.Convert_Radio_NoneVerify}"/>
            </StackPanel>
            
            <!-- Output Preferences Section -->
            <StackPanel Spacing="10" Margin="0,10,0,5">
                <Label Content="Output Preferences:" FontWeight="Bold" />
                <CheckBox IsChecked="{Binding Settings.DeleteProcessed}" dt:DelayedTooltip.Text="{x:Static tips:TooltipTexts.Convert_Check_DeleteProcessed}">Delete source files after successful verification</CheckBox>
                <CheckBox IsChecked="{Binding IsSkipIfCompletedSelected}" dt:DelayedTooltip.Text="{x:Static tips:TooltipTexts.Convert_Check_SkipIfCompleted}">Skip conversion if the desired output already exists</CheckBox>
                <CheckBox IsChecked="{Binding IsOutAsDatMatchSelected}" dt:DelayedTooltip.Text="{x:Static tips:TooltipTexts.Convert_Check_OutAsDatMatch}">Rename output according to DAT if a match is found</CheckBox>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>