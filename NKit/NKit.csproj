<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net8.0;netstandard2.1</TargetFrameworks>
		<AssemblyName>NKitLib</AssemblyName>
		<LangVersion>latest</LangVersion>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<UserSecretsId>88d8eb71-0161-479a-a935-869d282e4f3b</UserSecretsId>
		<RootNamespace>Nanook.NKit</RootNamespace>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Configurations>Debug;Release;ReleaseTest</Configurations>

		<!-- Version is centralized in Directory.Build.props (derived from git tags in CI) -->
		<!-- Suppress AOT and trim analysis warnings - CA2022-old Stream.Read -->
		<NoWarn>$(NoWarn);IL2104;IL3053;IL2026;IL2036;CA2022;CS0649</NoWarn>
		<SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'ReleaseTest'">
		<Optimize>true</Optimize>
		<DebugSymbols>false</DebugSymbols>
		<DebugType>none</DebugType>
		<DefineConstants>TRACE</DefineConstants>
		<ErrorReport>prompt</ErrorReport>
		<WarningLevel>4</WarningLevel>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Properties\**" />
		<EmbeddedResource Remove="Properties\**" />
		<None Remove="Properties\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="GrindCore" Version="0.9.0" />
		<PackageReference Include="GrindCore.SharpCompress" Version="0.50.5" />
		<PackageReference Include="System.Text.Encoding.CodePages" Version="11.0.0-preview.3.26207.106" />
	</ItemGroup>
	<ItemGroup>
		<FunctionsPreservedDependencies Include="System.Text.Encoding.CodePages.dll" />
	</ItemGroup>
	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>$(MSBuildProjectName).Tests</_Parameter1>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>NKitDataStore.Tests</_Parameter1>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>NKDSLib</_Parameter1>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>NkdsLib.Tests.BugCondition</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>
	<ItemGroup>
		<!-- Fix files for portable mode - ensure they are published -->
		<None Update="defaults\fix\fix_dreamcast.yaml">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		  <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<None Update="defaults\fix\fix_ps3.yaml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<None Update="defaults\fix\fix_gamecube.yaml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<None Update="defaults\fix\fix_wii.yaml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\NKitDataStore\NKitDataStore.csproj" />
	  <ProjectReference Include="..\NKitStream\NKitStream.csproj" />
	  <ProjectReference Include="..\NKitCore\NKitCore.csproj" />
	</ItemGroup>

</Project>
